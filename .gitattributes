# Auto-detect text files and normalize line endings to LF on check-in
* text=auto eol=lf

# PHP
*.php text eol=lf

# Web assets
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.htm text eol=lf

# Config / data
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf

# Windows scripts — keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never diff/merge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary

# Export-ignore (exclude from `git archive` / plugin zip releases)
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
ChangeLog.md export-ignore
README.txt export-ignore
