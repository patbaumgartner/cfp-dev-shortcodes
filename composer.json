{
    "name": "cfp-dev/cfp-dev-shortcodes",
    "description": "CFP.DEV WordPress shortcodes plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Stephan Janssen",
            "homepage": "https://x.com/stephan007"
        },
        {
            "name": "Patrick Baumgartner",
            "homepage": "https://x.com/patbaumgartner"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "lint": "phpcs",
        "lint-fix": "phpcbf",
        "test": "phpunit",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "CfpDev\\Tests\\": "tests/Support/"
        }
    }
}
